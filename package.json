{
  "name": "vesper",
  "private": true,
  "version": "0.2.0",
  "description": "Vesper — minimalist local music player for Windows",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "icon": "node scripts/make-icon.mjs",
    "tauri:dev": "node scripts/make-icon.mjs && tauri dev",
    "tauri:build": "node scripts/make-icon.mjs && tauri build"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2"
  }
}
