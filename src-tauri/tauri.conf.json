{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vesper",
  "version": "0.2.0",
  "identifier": "dev.vesper.player",
  "mainBinaryName": "vesper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vesper",
        "width": 1160,
        "height": 780,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": true
      },
      {
        "label": "widget",
        "url": "index.html?window=widget",
        "title": "Vesper Mini Player",
        "width": 384,
        "height": 188,
        "minWidth": 260,
        "minHeight": 88,
        "maxWidth": 560,
        "maxHeight": 340,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "visible": false,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "Shohail Mahmud",
    "copyright": "© 2026 Shohail Mahmud. All rights reserved.",
    "shortDescription": "Minimalist local music player for Windows with native EQ, synced lyrics, and glass desktop widget.",
    "longDescription": "Vesper plays the music files already on your machine. Import folders as tiles or individual audio files, control playback with hardware media keys, 10-band native equalizer, synced lyrics, system tray, and a translucent floating mini-player.",
    "category": "Music",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["mp3", "flac", "wav", "m4a", "aac", "ogg", "opus"],
        "mimeType": "audio/*",
        "description": "Audio Track"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
