{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vesper",
  "version": "0.4.0",
  "identifier": "dev.vesper.player",
  "mainBinaryName": "vesper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vesper",
        "width": 1180,
        "height": 800,
        "minWidth": 840,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": true,
        "visible": false
      },
      {
        "label": "widget",
        "url": "index.html?window=widget",
        "title": "Vesper Mini Player",
        "width": 416,
        "height": 112,
        "minWidth": 180,
        "minHeight": 92,
        "maxWidth": 560,
        "maxHeight": 380,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "visible": false,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      },
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "publisher": "Shohail Mahmud",
    "copyright": "\u00a9 2026 Shohail Mahmud. All rights reserved.",
    "shortDescription": "Minimalist local music player for Windows with custom covers, native EQ, synced lyrics, and a floating desktop widget.",
    "longDescription": "Vesper plays the music files already on your machine. Add permanent custom cover art to any song, import folders or tracks, control playback with hardware media keys, 10-band native equalizer, synced lyrics, and a floating desktop widget.",
    "category": "Music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "flac",
          "wav",
          "m4a",
          "aac",
          "ogg",
          "opus"
        ],
        "mimeType": "audio/*",
        "description": "Audio Track"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "./icons/icon.ico",
        "uninstallerIcon": "./icons/icon.ico",
        "headerImage": "./windows/installer-header.bmp",
        "sidebarImage": "./windows/installer-sidebar.bmp",
        "uninstallerHeaderImage": "./windows/installer-header.bmp"
      },
      "wix": {
        "language": "en-US"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
